# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.
#
# This file is committed to version control — do NOT put real secrets here.
# Copy this file to ".env" and populate with your values.
#
# When adding new environment variables, update the schema in "/src/env.js".

# Deployment: the image `docker compose` should run.
# Leave unset locally (`docker compose up --build` builds and tags `kooks:local`).
# On the VPS set it to the tag CI pushes, e.g. ghcr.io/<owner>/kooks:latest — without it
# `docker compose pull` has nothing to pull and `up -d` rebuilds from local source.
# KOOKS_IMAGE="ghcr.io/<owner>/kooks:latest"

# Database
# Local dev (outside Docker): use localhost:5432
# Inside Docker Compose: docker-compose.yml overrides this to use the 'db' service hostname
DATABASE_URL="postgresql://postgres:password@localhost:5432/kooks"

# Seed — used by prisma/seed.ts to create the primary user on first deploy
# Generate any random UUID: https://www.uuidgenerator.net/
SEED_INVITE_TOKEN=""

# SwellCloud surf conditions API key
# https://api.swellcloud.net/
SWELLCLOUD_API_KEY=""

# Conditions source: "swellcloud" (default) or "mock".
# SwellCloud is unreachable as of 2026-09-01 and a replacement is undecided, so local
# development runs on "mock" — deterministic synthetic conditions, no outbound call.
# Never set this to "mock" in production: the numbers are invented and someone could
# paddle out on them.
CONDITIONS_SOURCE="mock"

# The crew's timezone, for the 9pm and 5am scheduled pushes. IANA name.
# pg-boss schedules in UTC; this is what makes "9pm" mean 9pm where the crew lives.
APP_TIMEZONE="America/New_York"

# OpenAI API key (server-side only — never expose to client)
OPENAI_API_KEY=""

# Webcam URLs — JSON string mapping Break label to webcam URL
# Example: {"The Point":"https://www.youtube.com/watch?v=..."}
WEBCAM_URLS_JSON=""

# Web Push VAPID keys
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_EMAIL="mailto:your@email.com"

# Session secret — used to sign session tokens
# Generate with: openssl rand -base64 32
SESSION_SECRET=""
