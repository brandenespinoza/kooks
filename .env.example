# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.
#
# This file is committed to version control — do NOT put real secrets here.
# Copy this file to ".env" and populate with your values.
#
# When adding new environment variables, update the schema in "/src/env.js".

# --- Deployment (compose only — not read by src/env.js) ---------------------
# These are consumed by docker-compose*.yml, not by the app, so they are absent
# from src/env.js by design. Generate a full production file with:
#   ./deploy/make-env.sh

# The image `docker compose` should run.
# Leave unset locally (`docker compose up --build` builds and tags `kooks:local`).
# On the server set it to the tag CI pushes, e.g. ghcr.io/<owner>/kooks:latest — without it
# `docker compose pull` has nothing to pull and `up -d` rebuilds from local source.
# KOOKS_IMAGE="ghcr.io/<owner>/kooks:latest"

# The hostname Caddy obtains a certificate for, and the address Let's Encrypt
# emails about expiry. Both are required by docker-compose.prod.yml and unused
# locally — the prod overlay is the only file that references them.
# KOOKS_DOMAIN="kooks.example.com"
# ACME_EMAIL="you@example.com"

# Database
# Local dev (outside Docker): use localhost:5432
# Inside Docker Compose: docker-compose.yml overrides this to use the 'db' service hostname
DATABASE_URL="postgresql://postgres:password@localhost:5432/kooks"

# Postgres superuser password. Defaults to `password` so local compose is zero-config;
# set a generated value on any public host. The db port is never published, but
# "unreachable" and "unauthenticated" should not be the same line of defence.
# POSTGRES_PASSWORD=""

# Seed — used by prisma/seed.ts to create the primary user on first deploy
# Generate any random UUID: https://www.uuidgenerator.net/
SEED_INVITE_TOKEN=""

# SwellCloud surf conditions API key
# https://api.swellcloud.net/
SWELLCLOUD_API_KEY=""

# Conditions source: "swellcloud" (default) or "mock".
# SwellCloud is unreachable as of 2026-09-01 and a replacement is undecided (Open-Meteo
# Marine is the candidate), so this runs on "mock" — deterministic synthetic conditions,
# no outbound call — in production too, as of 2026-09-02. That is a deliberate override of
# the old "real source or nothing" rule: with the upstream dead the whole conditions
# feature sat dark, and a labelled simulation is more useful than a permanently empty band.
#
# The safety condition attached to that call: the numbers are invented, so the VerdictBand
# renders "Simulated — not a forecast" under every verdict while this is "mock". Do not
# remove that label without setting this back to "swellcloud" in the same commit.
CONDITIONS_SOURCE="mock"

# The crew's timezone, for the 9pm and 5am scheduled pushes. IANA name.
# pg-boss schedules in UTC; this is what makes "9pm" mean 9pm where the crew lives.
APP_TIMEZONE="America/New_York"

# OpenAI API key (server-side only — never expose to client)
OPENAI_API_KEY=""

# Webcam URLs — JSON string mapping Break label to webcam URL
# Example: {"The Point":"https://www.youtube.com/watch?v=..."}
WEBCAM_URLS_JSON=""

# Web Push VAPID keys
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_EMAIL="mailto:your@email.com"

