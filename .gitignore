.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# stale prisma client from a superseded `output = "../generated/prisma"` generator config;
# the current schema has no `output`, so nothing reads this
/generated

# agent tooling
# .claude/skills is committed — it pairs with the committed _bmad/ workflows.
# .agents/skills is a byte-identical duplicate for other harnesses; regenerate via the BMad installer.
/.agents
.claude/projects
.claude/settings.local.json